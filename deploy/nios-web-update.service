[Unit]
Description=Update NiosMess Flutter Web from verified public GitHub release
After=network-online.target nginx.service
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/nios-web/update.py
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/nios-flutter /var/cache/nios-web
